
.expand-challenge-btn:hover {
  background: var(--primary);
  color: white;
  padding-left: 20px;
}

.ide-wrapper {
  height: 100% !important;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.level-item { transition: all 0.3s ease; border-radius: 12px !important; margin-bottom: 6px; }
.level-item:hover { transform: translateX(5px); background: rgba(123, 47, 255, 0.1); }
.level-item.active { background: var(--primary) !important; color: white !important; }
