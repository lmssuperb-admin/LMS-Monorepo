# Node.js API Configuration
PORT=4000

# Moodle PHP Server URL (update this when you move the moodle folder)
MOODLE_URL=http://localhost:8080

# Moodle Admin Web Service Token (generate from Moodle Admin > Plugins > Web services > Manage tokens)
MOODLE_WS_TOKEN=your_moodle_webservice_token_here

# JWT Secret for Next.js ↔ Node API sessions
JWT_SECRET=change_this_to_a_long_random_secret_string

# Allowed frontend origin
CORS_ORIGIN=http://localhost:3000
