# Node.js API Configuration
PORT=4000

# Moodle PHP Server URL (update this when you move the moodle folder)
MOODLE_URL=http://localhost:8080

# Moodle Admin Web Service Token (generate from Moodle Admin > Plugins > Web services > Manage tokens)
MOODLE_WS_TOKEN="10a6555e0566465cf68f9099d522fe7f"

# Required webservice functions for cohort management (add to your external service):
# - core_cohort_get_cohorts
# - core_cohort_create_cohorts
# - core_cohort_delete_cohorts
# - core_cohort_get_cohort_members
# - core_cohort_add_cohort_members (optional, for assigning users to cohorts)
#
# User management (Manage Users page):
# - core_enrol_get_users_courses
# - core_enrol_get_enrolled_users
#
# If Moodle cohort APIs are not enabled yet, the API saves cohorts locally (cohorts.json).
# Set COHORT_PROVIDER=local to always use local storage, or moodle to require Moodle only.
COHORT_PROVIDER=auto

# JWT Secret for Next.js ↔ Node API sessions
JWT_SECRET=change_this_to_a_long_random_secret_string

# Allowed frontend origin
CORS_ORIGIN=http://localhost:3000
